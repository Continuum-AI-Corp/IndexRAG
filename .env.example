# OpenAI credentials (needed only for stages using the OpenAI provider)
OPENAI_API_KEY=sk-...

# Optional: Override default model for AKU extraction
# INDEXRAG_LLM_MODEL=gpt-4o-mini

# Optional: Override default embedding model
# INDEXRAG_EMBEDDING_MODEL=text-embedding-3-small

# Optional: use OrcaRouter for vector indexing and query embeddings.
# LLM calls are configured independently below.
# INDEXRAG_EMBEDDING_PROVIDER=orcarouter
# INDEXRAG_EMBEDDING_MODEL=openai/text-embedding-3-small
# ORCAROUTER_API_KEY=sk-orca-...
# Or omit ORCAROUTER_API_KEY after running: indexrag-auth login
# Optional endpoint overrides (HTTPS; HTTP only for local testing):
# ORCA_API_BASE_URL=https://api.orcarouter.ai
# ORCA_AUTH_BASE_URL=https://www.orcarouter.ai
# ORCA_BASE_URL is a shared fallback for both origins.

# Optional: route extraction, summaries, bridging and answers through OrcaRouter.
# Reuses ORCAROUTER_API_KEY or the existing indexrag-auth login.
# INDEXRAG_LLM_PROVIDER=orcarouter
# INDEXRAG_LLM_MODEL=deepseek/deepseek-v4.1-flash
